# Cloudflare Pages response headers for buscalctools.com
# Security + cache policy. Cloudflare reads this file natively at deploy time.

# ---------- Global security headers (every response) ----------
# Baseline CSP — defence-in-depth allowlist for the third-party scripts the
# site actually loads (AdSense, GA4 / GoogleTag, Microsoft Clarity, Plausible,
# Cookiebot once wired) plus the Beehiiv form action used by NewsletterCapture.
# 'unsafe-inline' is required for Next.js hydration + inline gtag/Clarity
# bootstrap; 'unsafe-eval' is required by AdSense. Both are standard for a
# static export shipping consent-gated ads.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=15768000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://*.google.com https://www.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://plausible.io https://*.cookiebot.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://www.googletagmanager.com https://*.clarity.ms https://plausible.io https://pagead2.googlesyndication.com https://*.cookiebot.com; frame-src 'self' https://googleads.g.doubleclick.net https://*.google.com https://*.doubleclick.net https://*.cookiebot.com; object-src 'none'; base-uri 'self'; form-action 'self' https://app.beehiiv.com; frame-ancestors 'self'; upgrade-insecure-requests

# ---------- Long-cache immutable static assets ----------
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ---------- Short cache for crawl-discovery files ----------
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# ---------- File-convention assets that have no extension ----------
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/twitter-image
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

# Per-calc Pinterest pin images (1000x1500) generated via ImageResponse.
# Route path has no extension; explicitly set Content-Type so crawlers parse it.
/pinterest-pin/*
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

# ---------- Phase 3 embed widget — cross-origin iframe + bundle ----------
# The /embed/* iframe HTML must be embeddable on any host site. Override the
# global X-Frame-Options: SAMEORIGIN with a permissive frame-ancestors policy.
# CORS is open so cross-origin script tags can fetch the bundle without CORB.
/embed/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Security-Policy: frame-ancestors *;
  X-Frame-Options: ALLOWALL
  Cache-Control: public, max-age=300, s-maxage=86400

/embed/*.js
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=86400
